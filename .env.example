# From your Strava API application settings
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Populated after running `npm run oauth`
STRAVA_REFRESH_TOKEN=

# A secret string you choose; used to verify webhook payloads
STRAVA_WEBHOOK_VERIFY_TOKEN=my-verify-token

PORT=3000

# Google Sheets
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
